# Databricks Connection Configuration Template
# Copy this file to .env and fill in your actual values
#
# To use:
#   cp .env.template .env
#   # Edit .env with your credentials
#   source .env
#   cargo run --example demo_app

# Required: Your Databricks workspace URL
# Example: https://dbc-12345678-9abc.cloud.databricks.com
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com

# Required: Your SQL Warehouse ID
# Find this in: SQL Warehouses → Your Warehouse → Connection Details
# Example: 1234567890abcdef
DATABRICKS_WAREHOUSE_ID=your-warehouse-id

# Required: Your Personal Access Token
# Generate at: User Settings → Access Tokens → Generate New Token
# Example: 
DATABRICKS_TOKEN=d_your_token_here

# Optional: Default catalog to use for queries
# Common values: "main", "hive_metastore"
# Leave commented out to not set a default
# DATABRICKS_CATALOG=main

# Optional: Default schema to use for queries
# Common values: "default", "information_schema"
# Leave commented out to not set a default
# DATABRICKS_SCHEMA=default
